# Deployer key. Needs a little ETH on Base for gas, and a dollar of USDC if you are
# also going to open the first session.
PRIVATE_KEY=0x

# From basescan.org/myapikey. Only needed for --verify.
BASESCAN_API_KEY=

# Which equity to run. Defaults to Apple.
#   AAPL 0x787f13dEa48Db0897CbCDD985de77809D837F988
#   NVDA 0x04689a41629776563E6822F76f2e57D148d28513
#   TSLA 0xFaf869185383a24F8cb00e27BdA6b63B9905DCb4
#   MSFT 0xeB10A6c9aa7E537aEd766C08c35Dae35B321b18c
#   COIN 0x408e44f504A7371a345F03a73dDC96A4b48e8aa7
FEED=0x787f13dEa48Db0897CbCDD985de77809D837F988

# Filled in after Deploy runs.
CLOCK=
MARKET=

# LMSR depth. Two things scale off this, so it sets the whole cost of running one
# session. The subsidy you post is b * ln(21), and it caps what the book can lose.
# Trades scale with b too: around b/2 shifts a bucket a few points, many multiples
# of b pin it at once and cost far more than the subsidy does.
#   0.05e18 -> $0.15      0.5e18 -> $1.52
#   0.1e18  -> $0.30      1e18   -> $3.04
#   0.2e18  -> $0.61      20e18  -> $60.89
B=200000000000000000
STEP=5000000000000000

# Guards on the implied price. minDepth is USDC taken in before anyone should read
# it at all; raise both a long way before letting anything borrow against this.
MIN_DEPTH=1000000
MAX_DEVIATION_BPS=1000
